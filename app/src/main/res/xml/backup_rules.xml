<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 及以下 (API <=30) fullBackupContent 兼容规则，语义与 data_extraction_rules.xml 一致：
    - 只包含 Room 聊天数据库（有 <include> 时仅备份所列条目，datastore/ 明文 API Key 与
      其余文件天然不在备份内——显式 <exclude domain="file"> 会触发 lint FullBackupContent
      错误「not in an included path」，故不写）。
    注意：domain="database" 对应 internal database 目录，Room 默认位于该目录。
-->
<full-backup-content>
    <include domain="database" path="." />
</full-backup-content>
