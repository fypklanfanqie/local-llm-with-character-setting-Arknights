<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) 数据提取规则：云备份（cloud-backup）与设备迁移（device-transfer）共用。

    - 只包含 databases/：Room 聊天记录随备份/换机迁移是产品期望。有 <include> 时仅备份所列
      条目，datastore/（明文 API Key，绝不外带）与图片缓存等其余文件天然不被备份——显式
      <exclude domain="file"> 会触发 lint FullBackupContent 错误「not in an included path」，故不写。
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
